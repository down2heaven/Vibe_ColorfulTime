<ContentDialog
    x:Class="SimWorkbench.App.Dialogs.TaskEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SimWorkbench.App.ViewModels"
    Title="任务"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Width="540" Spacing="2">
            <TextBlock Text="任务名称（必填）" Style="{StaticResource FieldLabelTextStyle}" />
            <TextBox x:Name="TitleBox" PlaceholderText="例如：机翼气动仿真 - 工况 A" />

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="任务类型" Style="{StaticResource FieldLabelTextStyle}" />
                    <ComboBox x:Name="KindBox" HorizontalAlignment="Stretch" SelectionChanged="OnKindChanged">
                        <ComboBoxItem Content="一般任务" />
                        <ComboBoxItem Content="仿真任务" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="当前状态" Style="{StaticResource FieldLabelTextStyle}" />
                    <ComboBox x:Name="StatusBox" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:StatusChoice">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="10" Height="10" CornerRadius="5"
                                            Background="{x:Bind Brush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="优先级" Style="{StaticResource FieldLabelTextStyle}" />
                    <ComboBox x:Name="PriorityBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="普通" />
                        <ComboBoxItem Content="高" />
                        <ComboBoxItem Content="紧急" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="分类" Style="{StaticResource FieldLabelTextStyle}" />
                    <ComboBox x:Name="CategoryBox" HorizontalAlignment="Stretch" IsEditable="True" />
                </StackPanel>
            </Grid>

            <TextBlock Text="标签（用分号分隔，例如：CFD;关键）" Style="{StaticResource FieldLabelTextStyle}" />
            <TextBox x:Name="TagsBox" PlaceholderText="标签1;标签2" />

            <TextBlock Text="描述 / 备注" Style="{StaticResource FieldLabelTextStyle}" />
            <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="64" MaxHeight="120" />

            <TextBlock Text="创建日期（默认今天，可手动修改）" Style="{StaticResource FieldLabelTextStyle}" />
            <CalendarDatePicker x:Name="CreatedPicker" HorizontalAlignment="Stretch" PlaceholderText="创建日期" />

            <TextBlock Text="计划开始 / 计划交付" Style="{StaticResource FieldLabelTextStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <CalendarDatePicker x:Name="StartDatePicker" Grid.Column="0" HorizontalAlignment="Stretch"
                                    PlaceholderText="开始日期" />
                <TimePicker x:Name="StartTimePicker" Grid.Column="1" ClockIdentifier="24HourClock" />
                <CalendarDatePicker x:Name="DueDatePicker" Grid.Column="2" HorizontalAlignment="Stretch"
                                    PlaceholderText="交付日期" />
                <TimePicker x:Name="DueTimePicker" Grid.Column="3" ClockIdentifier="24HourClock" />
            </Grid>

            <TextBlock Text="实际交付时间（可留空，完成后可填入）" Style="{StaticResource FieldLabelTextStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CalendarDatePicker x:Name="ActualDatePicker" Grid.Column="0" HorizontalAlignment="Stretch"
                                    PlaceholderText="实际交付日期" />
                <TimePicker x:Name="ActualTimePicker" Grid.Column="1" ClockIdentifier="24HourClock" />
                <Button x:Name="NowButton" Grid.Column="2" Content="现在" Click="OnFillNow"
                        VerticalAlignment="Bottom" />
            </Grid>

            <!-- 仿真任务专属字段 -->
            <StackPanel x:Name="SimulationPanel" Visibility="Collapsed">
                <TextBlock Text="关联计算任务 / 算例名称" Style="{StaticResource FieldLabelTextStyle}" />
                <TextBox x:Name="CaseNameBox" PlaceholderText="例如：CASE-A-001" />

                <TextBlock Text="计算工况 / 计算说明" Style="{StaticResource FieldLabelTextStyle}" />
                <TextBox x:Name="CaseConditionBox" PlaceholderText="例如：Ma=0.6, Alt=10km" />

                <TextBlock Text="计算所需时间（手动维护，随时可改）" Style="{StaticResource FieldLabelTextStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <NumberBox x:Name="HoursBox" Minimum="0" Maximum="10000" SmallChange="1"
                                   SpinButtonPlacementMode="Compact" PlaceholderText="小时" Width="120" />
                        <TextBlock Text="小时" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <NumberBox x:Name="MinutesBox" Minimum="0" Maximum="59" SmallChange="5"
                                   SpinButtonPlacementMode="Compact" PlaceholderText="分钟" Width="120" />
                        <TextBlock Text="分钟" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="计算相关备注（模型 / 网格 / 边界条件 / 求解器设置等）"
                           Style="{StaticResource FieldLabelTextStyle}" />
                <TextBox x:Name="CalcNotesBox" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="64" MaxHeight="120" />
            </StackPanel>

            <!-- 周期实例信息 -->
            <StackPanel x:Name="RecurrencePanel" Visibility="Collapsed" Margin="0,12,0,0">
                <Border Style="{StaticResource InsetCardBorderStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="RecurrenceInfoText" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   Text="修改本实例只影响这一次执行；如需修改整条规则，请在“周期任务”中编辑规则。" />
                        <Button x:Name="SkipOccurrenceButton" Content="跳过本次执行" Click="OnSkipOccurrence"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="#D13438" Visibility="Collapsed"
                       TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
