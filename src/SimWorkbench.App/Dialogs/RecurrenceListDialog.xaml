<ContentDialog
    x:Class="SimWorkbench.App.Dialogs.RecurrenceListDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SimWorkbench.App.ViewModels"
    Title="周期任务"
    PrimaryButtonText="新建规则"
    CloseButtonText="关闭"
    DefaultButton="Primary">

    <StackPanel Width="560" Spacing="10">
        <TextBlock Style="{StaticResource CaptionTextStyle}"
                   Text="每次周期执行都会生成独立的任务实例：完成本周任务不会影响下周任务。修改规则时默认只重建今天及以后的实例，历史实例保留。" />
        <ListView x:Name="RuleList" Height="340" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:RecurrenceRow">
                    <Grid ColumnSpacing="8" Padding="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource TaskRowTitleStyle}" />
                            <TextBlock Text="{x:Bind FrequencyText}" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{x:Bind FutureText}" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center">
                            <Button Content="编辑" Tag="{x:Bind Rule}" Click="OnEditRule" />
                            <Button Content="删除" Tag="{x:Bind Rule}" Click="OnDeleteRule" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="EmptyText" Style="{StaticResource CaptionTextStyle}" Visibility="Collapsed"
                   Text="尚未创建周期任务。点击“新建规则”创建每日、每周或每月重复任务。" />
    </StackPanel>
</ContentDialog>
