<ContentDialog
    x:Class="SimWorkbench.App.Dialogs.RecurrenceEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SimWorkbench.App.ViewModels"
    Title="周期规则"
    PrimaryButtonText="保存规则"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ScrollViewer MaxHeight="540" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Width="520" Spacing="2">
            <TextBlock Text="任务名称（必填）" Style="{StaticResource FieldLabelTextStyle}" />
            <TextBox x:Name="TitleBox" PlaceholderText="例如：每周组会准备" />

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="任务类型" Style="{StaticResource FieldLabelTextStyle}" />
                    <ComboBox x:Name="KindBox" HorizontalAlignment="Stretch" SelectionChanged="OnKindChanged">
                        <ComboBoxItem Content="一般任务" />
                        <ComboBoxItem Content="仿真任务" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="默认状态" Style="{StaticResource FieldLabelTextStyle}" />
                    <ComboBox x:Name="StatusBox" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:StatusChoice">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="10" Height="10" CornerRadius="5"
                                            Background="{x:Bind Brush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <TextBlock Text="重复频率" Style="{StaticResource FieldLabelTextStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="FrequencyBox" Grid.Column="0" HorizontalAlignment="Stretch"
                          SelectionChanged="OnFrequencyChanged">
                    <ComboBoxItem Content="每天" />
                    <ComboBoxItem Content="每周" />
                    <ComboBoxItem Content="每月" />
                </ComboBox>
                <TextBlock Grid.Column="1" Text="每" VerticalAlignment="Center" />
                <NumberBox x:Name="IntervalBox" Grid.Column="2" Minimum="1" Maximum="365" Value="1"
                           SpinButtonPlacementMode="Compact" />
                <TextBlock x:Name="IntervalUnitText" Grid.Column="3" Text="周" VerticalAlignment="Center" />
            </Grid>

            <StackPanel x:Name="WeekDayPanel">
                <TextBlock Text="每周指定星期（不选则使用开始日期的星期）" Style="{StaticResource FieldLabelTextStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ToggleButton x:Name="MonButton" Content="一" Click="OnWeekDayToggled" />
                    <ToggleButton x:Name="TueButton" Content="二" Click="OnWeekDayToggled" />
                    <ToggleButton x:Name="WedButton" Content="三" Click="OnWeekDayToggled" />
                    <ToggleButton x:Name="ThuButton" Content="四" Click="OnWeekDayToggled" />
                    <ToggleButton x:Name="FriButton" Content="五" Click="OnWeekDayToggled" />
                    <ToggleButton x:Name="SatButton" Content="六" Click="OnWeekDayToggled" />
                    <ToggleButton x:Name="SunButton" Content="日" Click="OnWeekDayToggled" />
                </StackPanel>
            </StackPanel>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="开始日期" Style="{StaticResource FieldLabelTextStyle}" />
                    <CalendarDatePicker x:Name="StartDatePicker" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="结束日期（可选）" Style="{StaticResource FieldLabelTextStyle}" />
                    <CalendarDatePicker x:Name="EndDatePicker" HorizontalAlignment="Stretch"
                                        PlaceholderText="不设置表示长期重复" />
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="优先级" Style="{StaticResource FieldLabelTextStyle}" />
                    <ComboBox x:Name="PriorityBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="普通" />
                        <ComboBoxItem Content="高" />
                        <ComboBoxItem Content="紧急" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="分类" Style="{StaticResource FieldLabelTextStyle}" />
                    <ComboBox x:Name="CategoryBox" HorizontalAlignment="Stretch" IsEditable="True" />
                </StackPanel>
            </Grid>

            <TextBlock Text="标签（用分号分隔）" Style="{StaticResource FieldLabelTextStyle}" />
            <TextBox x:Name="TagsBox" />

            <TextBlock Text="描述 / 备注" Style="{StaticResource FieldLabelTextStyle}" />
            <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="56" MaxHeight="100" />

            <StackPanel x:Name="SimulationPanel" Visibility="Collapsed">
                <TextBlock Text="关联计算任务 / 算例名称" Style="{StaticResource FieldLabelTextStyle}" />
                <TextBox x:Name="CaseNameBox" />
                <TextBlock Text="计算工况 / 说明" Style="{StaticResource FieldLabelTextStyle}" />
                <TextBox x:Name="CaseConditionBox" />
                <TextBlock Text="计算所需时间（小时）" Style="{StaticResource FieldLabelTextStyle}" />
                <NumberBox x:Name="HoursBox" Minimum="0" Maximum="10000" SmallChange="0.5"
                           SpinButtonPlacementMode="Compact" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="#D13438" Visibility="Collapsed"
                       TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
