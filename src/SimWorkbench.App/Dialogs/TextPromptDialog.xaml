<ContentDialog
    x:Class="SimWorkbench.App.Dialogs.TextPromptDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="确定"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <StackPanel Width="420" Spacing="6">
        <TextBlock x:Name="PromptText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
        <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="160" />
        <TextBlock x:Name="ErrorText" Foreground="#D13438" Visibility="Collapsed" TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
