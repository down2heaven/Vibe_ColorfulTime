<ContentDialog
    x:Class="SimWorkbench.App.Dialogs.ChecklistLinkDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="关联 Checklist"
    PrimaryButtonText="保存关联"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <StackPanel Width="440" Spacing="10">
        <TextBlock Style="{StaticResource CaptionTextStyle}"
                   Text="勾选需要关联到当前对象的清单。关联只建立引用，不会复制或修改清单内容。" />
        <ScrollViewer MaxHeight="320">
            <StackPanel x:Name="ChecklistHost" Spacing="6" />
        </ScrollViewer>
        <TextBlock x:Name="EmptyText" Style="{StaticResource CaptionTextStyle}" Visibility="Collapsed"
                   Text="还没有创建任何 Checklist，请先到 Checklist 页面创建。" />
    </StackPanel>
</ContentDialog>
