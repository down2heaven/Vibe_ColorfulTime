<Page
    x:Class="SimWorkbench.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,28">
        <StackPanel Spacing="14" MaxWidth="1000" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="6" Height="28" CornerRadius="3" Background="#6B7280" VerticalAlignment="Center" />
                <TextBlock Text="设置" Style="{StaticResource PageTitleTextStyle}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- 外观与布局 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="外观与布局" Style="{StaticResource SectionTitleTextStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="主题" Style="{StaticResource FieldLabelTextStyle}" />
                            <ComboBox x:Name="ThemeBox" Width="160" SelectionChanged="OnThemeChanged">
                                <ComboBoxItem Content="跟随系统" />
                                <ComboBoxItem Content="浅色" />
                                <ComboBoxItem Content="深色" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="默认打开的页面" Style="{StaticResource FieldLabelTextStyle}" />
                            <ComboBox x:Name="StartPageBox" Width="180" SelectionChanged="OnStartPageChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <Button Content="恢复默认布局" Click="OnResetLayout" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="布局与外观设置会立即保存，重启程序后仍然生效。" />
                </StackPanel>
            </Border>

            <!-- 导航入口 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="导航入口显示" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="隐藏入口只会从导航栏移除入口，数据和模块服务仍然保留。" />
                    <StackPanel x:Name="NavHost" Spacing="4" />
                </StackPanel>
            </Border>

            <!-- 首页卡片 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="首页卡片" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="可显示/隐藏卡片并调整顺序；停用相关模块时对应卡片会自动隐藏。" />
                    <StackPanel x:Name="CardsHost" Spacing="4" />
                </StackPanel>
            </Border>

            <!-- 状态管理 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="任务状态" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="状态名称、颜色与顺序可自定义；颜色在列表、日历和详情中保持一致。删除仍被任务使用的状态时必须先迁移任务。" />
                    <CheckBox x:Name="GeneralShareStatusesBox" Content="允许一般任务使用仿真任务状态集合"
                              Click="OnGeneralShareChanged" />
                    <TextBlock Text="仿真任务状态" Style="{StaticResource FieldLabelTextStyle}" />
                    <StackPanel x:Name="SimStatusHost" Spacing="4" />
                    <Button Content="新建仿真状态" Click="OnAddSimulationStatus" HorizontalAlignment="Left" />
                    <TextBlock Text="一般任务状态" Style="{StaticResource FieldLabelTextStyle}" />
                    <StackPanel x:Name="GeneralStatusHost" Spacing="4" />
                    <Button Content="新建一般状态" Click="OnAddGeneralStatus" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- 模块管理 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="模块管理" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="核心基础设施不可停用；可选模块停用后不再提供界面与后续后台工作，数据与配置保留，重新启用后继续使用。未实现的功能不会显示为可用。" />
                    <StackPanel x:Name="ModulesHost" Spacing="8" />
                </StackPanel>
            </Border>

            <!-- 数据与备份 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="数据与备份" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock x:Name="DataPathText" Style="{StaticResource CaptionTextStyle}" IsTextSelectionEnabled="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="导出备份（JSON）" Style="{StaticResource AccentButtonStyle}" Click="OnExportBackup" />
                        <Button Content="导入备份" Click="OnImportBackup" />
                        <Button Content="打开数据目录" Click="OnOpenDataFolder" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="备份范围：任务、状态、周期规则与实例、每日总结及其关联、主题日志与断点历史、Checklist 与检查项、跨模块关联、界面与模块配置。导入时可选择“合并”（跳过重复数据）或“替换”（先清空当前业务数据）。" />
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="关于" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock x:Name="AboutText" Style="{StaticResource BodyTextStyle}" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="当前版本未包含的功能（不会伪装成可用）：AI 助手、网络 API 连接器、自动仿真状态监测、通知与自动化规则、第三方插件系统。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
