<Page
    x:Class="SimWorkbench.App.Pages.TopicLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SimWorkbench.App.ViewModels">

    <Grid Padding="24,16,24,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Width="6" Height="28" CornerRadius="3" Background="#C239B3" VerticalAlignment="Center" />
            <TextBlock Text="主题日志 / 断点" Style="{StaticResource PageTitleTextStyle}" VerticalAlignment="Center" />
            <TextBlock x:Name="CountText" Style="{StaticResource CaptionTextStyle}"
                       VerticalAlignment="Bottom" Margin="2,0,0,6" />
            <Button Content="新建主题" Style="{StaticResource AccentButtonStyle}" Click="OnNewTopic" />
            <Button Content="刷新" Click="OnRefresh" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="SearchBox" Width="240" PlaceholderText="搜索主题 / 断点 / 内容 / 标签"
                     TextChanged="OnSearchChanged" />
            <ComboBox x:Name="CategoryFilter" Width="150" SelectionChanged="OnFilterChanged" />
            <TextBox x:Name="TagFilter" Width="140" PlaceholderText="按标签过滤" TextChanged="OnSearchChanged" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="8">
                <ListView x:Name="TopicList" SelectionMode="Single" SelectionChanged="OnTopicSelected">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TopicRow">
                            <StackPanel Spacing="3" Padding="0,5">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource TaskRowTitleStyle}" />
                                <TextBlock Text="{x:Bind CategoryText}" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{x:Bind BreakpointText}" Style="{StaticResource BodyTextStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind UpdatedText}" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="EditorTitleText" Style="{StaticResource SectionTitleTextStyle}"
                                   Text="选择一个主题，或新建主题" />
                        <StackPanel x:Name="EditorPanel" Spacing="2">
                            <TextBlock Text="主题名称（必填）" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox x:Name="TitleBox" PlaceholderText="例如：艾尔登法环进度 / Abaqus 学习笔记" />

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="类别（可自定义）" Style="{StaticResource FieldLabelTextStyle}" />
                                    <ComboBox x:Name="CategoryBox" IsEditable="True" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="标签（分号分隔）" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBox x:Name="TagsBox" PlaceholderText="游戏;主线" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="当前进度 / 断点（重点）" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox x:Name="BreakpointBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="72" PlaceholderText="例如：第二章 湖之利耶尼亚 / 网格前处理卡在边界层" />
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Text="保存时会自动把旧断点写入历史记录，不会被直接覆盖。" />

                            <TextBlock Text="详细内容 / 本次记录" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox x:Name="ContentBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="110" PlaceholderText="本次做了什么、下一步准备做什么" />

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                                <Button Content="保存并保留历史" Style="{StaticResource AccentButtonStyle}"
                                        Click="OnSave" />
                                <Button Content="删除主题" Click="OnDelete" />
                                <Button Content="关联清单" Click="OnLinkChecklists" />
                                <TextBlock x:Name="SaveStatusText" Style="{StaticResource CaptionTextStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="历史更新记录" Style="{StaticResource SectionTitleTextStyle}"
                                       Margin="0,16,0,4" />
                            <TextBlock x:Name="HistoryEmptyText" Style="{StaticResource CaptionTextStyle}"
                                       Text="暂无历史记录：保存时若断点或内容发生变化，旧内容会自动存入历史。"
                                       Visibility="Collapsed" />
                            <ListView x:Name="HistoryList" Height="200" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HistoryRow">
                                        <StackPanel Spacing="2" Padding="0,4">
                                            <TextBlock Text="{x:Bind ChangedText}" Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Text="{x:Bind BreakpointText}" Style="{StaticResource BodyTextStyle}" />
                                            <TextBlock Text="{x:Bind ContentText}" Style="{StaticResource CaptionTextStyle}"
                                                       Visibility="{x:Bind ContentVisibility}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
